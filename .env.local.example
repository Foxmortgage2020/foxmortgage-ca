NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/portal/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/portal/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/portal/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/portal/dashboard

RESEND_API_KEY=re_placeholder

# Impersonation cookie signing key. Generate with: openssl rand -base64 32
SESSION_SECRET=placeholder_replace_with_32_byte_base64_secret

# Session 9: set to "true" to make admin-only demo mode available (recruiting
# instrument). Server-only, never NEXT_PUBLIC. Unset = demo mode is inert.
DEMO_MODE_ENABLED=
